# ai-interview-service/.env
# Copy this and fill in your actual values

# Groq API key (used for both Whisper STT and LLaMA answer evaluation)
GROQ_API_KEY=your_groq_api_key_here

# HireVerse webhook (where AI service posts results when interview completes)
HIREVERSE_WEBHOOK_URL=http://localhost:3000/api/ai-interview/complete
HIREVERSE_WEBHOOK_SECRET=change-me-to-a-strong-random-string

# Shared secret for authenticating requests from the Next.js proxy
# Must match AI_SERVICE_AUTH_SECRET in the Next.js .env
AI_SERVICE_AUTH_SECRET=change-me-to-a-strong-random-string

# CORS — comma-separated allowed origins (no trailing slash)
# Add your production domain when deploying
ALLOWED_ORIGINS=http://localhost:3000

# Port for the FastAPI service
PORT=8000
