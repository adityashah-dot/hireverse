# ================================================
# HireVerse - Environment Variables
# Copy this file to .env.local and fill in values
# ================================================

# ---- DATABASE ----
# Supabase pooled connection (runtime)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Supabase direct connection (migrations)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ---- NEXT AUTH ----
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers (optional — fall back to credentials-only if unset)
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# GitHub: https://github.com/settings/developers
GITHUB_ID=""
GITHUB_SECRET=""

# ---- APP ----
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ---- GROQ (AI — replaced OpenAI) ----
GROQ_API_KEY="gsk_..."

# ---- AWS S3 / CLOUDFLARE R2 ----
S3_ACCESS_KEY_ID="your-access-key-id"
S3_SECRET_ACCESS_KEY="your-secret-access-key"
S3_BUCKET="hireverse-uploads"
S3_REGION="us-east-1"
# For Cloudflare R2, set the endpoint:
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# For public URL (optional, for R2 public bucket):
# S3_PUBLIC_URL="https://pub-xxx.r2.dev"

# ---- RESEND (Email) ----
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@yourdomain.com"

# ---- REDIS (BullMQ) ----
REDIS_URL="redis://localhost:6379"

# ---- AI INTERVIEW SERVICE ----
AI_INTERVIEW_SERVICE_URL="http://localhost:8000"
AI_INTERVIEW_WEBHOOK_SECRET="change-me-to-a-strong-random-string"
AI_SERVICE_AUTH_SECRET="change-me-to-a-strong-random-string"

# ---- SLACK / TEAMS (Optional) ----
SLACK_WEBHOOK_URL=""
TEAMS_WEBHOOK_URL=""
